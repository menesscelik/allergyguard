{
  "expo": {
    "name": "AllergyGuard",
    "slug": "allergyguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "com.menescelik.allergyguard",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.menescelik.allergyguard",
      "usesAppleSignIn": true,
      "entitlements": {
        "com.apple.security.application-groups": ["group.com.menescelik.allergyguard"]
      }
    },
    "android": {
      "package": "com.menescelik.allergyguard",
      "adaptiveIcon": {
        "backgroundColor": "#176BEB",
        "foregroundImage": "./assets/images/icon.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "@bacons/apple-targets",
      [
        "expo-camera",
        {
          "cameraPermission": "İlaç kutusundaki barkodu okumak için kamera erişimi gerekiyor.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F7F8FC",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-localization",
      "./plugins/without-push-entitlement.js",
      "expo-apple-authentication",
      "react-native-adapty",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "dynamic"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
